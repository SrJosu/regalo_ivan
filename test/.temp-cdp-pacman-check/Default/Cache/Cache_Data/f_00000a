/**
 * js/game.js - Main Game Loop, State Manager, HUD & Victory UI Controller
 *
 * V2 Iván's Birthday Gift Edition (M3)
 *
 * Coordinates Assets, Physics, Multi-Touch Input, Audio, Level World,
 * Personalized HUD ("IVÁN", "🎂 × 00", "WORLD 2026"), Deal-With-It Clouds,
 * Celebratory Victory Modal (#victory-modal) with Exact Reward Button,
 * Confetti Cannon FX, and 60 FPS smooth rendering.
 */
(function (global) {
  'use strict';

  // Game Configuration Constants
  const VIEWPORT_WIDTH = 180;  // Virtual width in world coordinate units (at 2x scale -> 360px canvas)
  const VIEWPORT_HEIGHT = 400; // Virtual height in world coordinate units (at 2x scale -> 800px canvas)
  const WORLD_SCALE = 2;       // 360 / 180 = 2

  class GameManager {
    constructor() {
      this.canvas = null;
      this.ctx = null;

      // DOM HUD Elements
      this.hudScore = null;
      this.hudCoins = null;
      this.hudWorld = null;
      this.hudTime = null;
      this.hudLives = null;

      // DOM Victory Modal Elements
      this.victoryModal = null;
      this.rewardBtn = null;
      this.btnReplay = null;
      this.winScore = null;
      this.winCoins = null;
      this.winTime = null;
      this.modalRevealed = false;

      // Game States: 'LOADING', 'START', 'PLAYING', 'WIN', 'GAMEOVER'
      this.state = 'LOADING';

      // Gameplay Statistics
      this.score = 0;
      this.coins = 0;
      this.lives = 3;
      this.time = 400;
      this.timeTimer = 0;

      // Entities & World
      this.level = null;
      this.player = null;
      this.goombas = [];
      this.coinsList = [];
      this.blockCoins = [];
      this.particles = [];
      this.goalFlag = null;

      // Timing & Loop
      this.lastTime = 0;
      this.isRunning = false;
      this.winTimer = 0;
      this.gameOverTimer = 0;
      this.comboStreak = 0;

      // Bound Animation Frame Loop
      this.loop = this.loop.bind(this);
    }

    /**
     * Safely triggers haptic feedback vibration on mobile devices (Android).
     */
    triggerHaptic(pattern) {
      if (typeof navigator !== 'undefined' && typeof navigator.vibrate === 'function') {
        try {
          navigator.vibrate(pattern);
        } catch (err) {
          // Ignore devices where vibrate is restricted
        }
      }
    }

    /**
     * Initializes all subsystems and starts the game.
     */
    async init(autoStart = true) {
      // 1. Locate Canvas & HUD DOM Elements
      if (typeof document !== 'undefined') {
        this.canvas = document.getElementById('game-canvas');
        if (this.canvas) {
          this.ctx = this.canvas.getContext('2d');
          // Pixel-art image smoothing disabled
          if (this.ctx) {
            this.ctx.imageSmoothingEnabled = false;
          }
        }

        this.hudScore = document.getElementById('hud-score');
        this.hudCoins = document.getElementById('hud-coins');
        this.hudWorld = document.getElementById('hud-world');
        this.hudTime = document.getElementById('hud-time');
        this.hudLives = document.getElementById('hud-lives');

        // Victory Modal Elements
        this.victoryModal = document.getElementById('victory-modal');
        this.rewardBtn = document.getElementById('reward-btn');
        this.btnReplay = document.getElementById('btn-replay');
        this.winScore = document.getElementById('win-score');
        this.winCoins = document.getElementById('win-coins');
        this.winTime = document.getElementById('win-time');

        if (this.btnReplay) {
          const handleReplay = (e) => {
            if (e) {
              e.stopPropagation();
              if (e.cancelable) e.preventDefault();
            }
            this.restart();
          };
          this.btnReplay.addEventListener('click', handleReplay);
          this.btnReplay.addEventListener('touchend', handleReplay);
        }

        // Initialize Input & Audio
        if (global.GameInput && global.GameInput.init) {
          global.GameInput.init(document.getElementById('touch-controls') || document.body);
        }
        if (global.GameAudio && global.GameAudio.init) {
          global.GameAudio.init();
        }
      }

      // 2. Initialize Asset Pipeline
      if (global.GameAssets && global.GameAssets.init) {
        await global.GameAssets.init();
      }

      // 3. Create Level & Entities
      this.startNewGame();

      // 4. Start Render Loop only if requested
      if (autoStart) {
        this.state = 'PLAYING';
        this.isRunning = true;
        if (typeof requestAnimationFrame !== 'undefined') {
          this.lastTime = performance.now();
          requestAnimationFrame(this.loop);
        }
      } else {
        this.isRunning = false;
        if (global.GameAudio && global.GameAudio.stopAll) {
          global.GameAudio.stopAll();
        }
      }
    }

    start() {
      if (!this.isRunning) {
        this.isRunning = true;
        this.lastTime = performance.now();
        if (typeof requestAnimationFrame !== 'undefined') {
          requestAnimationFrame(this.loop);
        }
      }
    }

    stop() {
      this.isRunning = false;
      if (global.GameAudio && global.GameAudio.stopAll) {
        global.GameAudio.stopAll();
      }
    }

    /**
     * Reveals the Celebratory Victory Modal overlay with final game statistics.
     */
    showVictoryModal() {
      if (this.winScore) {
        this.winScore.textContent = String(this.score).padStart(6, '0');
      }
      if (this.winCoins) {
        this.winCoins.textContent = String(this.coins).padStart(2, '0');
      }
      if (this.winTime) {
        this.winTime.textContent = String(Math.max(0, Math.ceil(this.time))).padStart(3, '0');
      }
      if (this.victoryModal) {
        this.victoryModal.classList.remove('hidden');
      }
    }

    /**
     * Hides the Celebratory Victory Modal overlay.
     */
    hideVictoryModal() {
      if (this.victoryModal) {
        this.victoryModal.classList.add('hidden');
      }
    }

    /**
     * Resets level and entities for a fresh run or restart.
     */
    startNewGame() {
      this.time = 400;
      this.timeTimer = 0;
      this.winTimer = 0;
      this.gameOverTimer = 0;
      this.modalRevealed = false;
      this.hideVictoryModal();

      // Create Level
      if (global.GameLevel && global.GameLevel.createLevel) {
        this.level = global.GameLevel.createLevel();
      } else {
        this.level = null;
      }

      // Create Player at starting location
      const startX = 40;
      const startY = (this.level ? this.level.GROUND_ROW * 16 : 208) - 16;
      if (global.GameEntities && global.GameEntities.createPlayer) {
        this.player = global.GameEntities.createPlayer(startX, startY);
      } else {
        this.player = null;
      }

      // Spawn Meme Enemies from level layout
      this.goombas = [];
      if (this.level && this.level.enemySpawns && global.GameEntities) {
        this.level.enemySpawns.forEach(spawn => {
          const enemy = global.GameEntities.createMemeEnemy
            ? global.GameEntities.createMemeEnemy(spawn.type, spawn.x, spawn.y)
            : global.GameEntities.createGoomba(spawn.x, spawn.y);
          this.goombas.push(enemy);
        });
      }

      // Spawn Collectible Coins from level layout
      this.coinsList = [];
      if (this.level && this.level.coinSpawns && global.GameEntities) {
        this.level.coinSpawns.forEach(spawn => {
          this.coinsList.push(global.GameEntities.createCoin(spawn.x, spawn.y));
        });
      }

      this.blockCoins = [];
      this.particles = [];

      // Create Goal Flag
      if (this.level && this.level.flagpole && global.GameEntities && global.GameEntities.GoalFlag) {
        this.goalFlag = new global.GameEntities.GoalFlag(
          this.level.flagpole.x,
          this.level.flagpole.topY,
          this.level.flagpole.bottomY
        );
      } else {
        this.goalFlag = null;
      }

      this.state = 'PLAYING';
      this.updateHUD();
    }

    /**
     * Restart helper.
     */
    restart() {
      this.score = 0;
      this.coins = 0;
      this.lives = 3;
      this.startNewGame();
    }

    /**
     * Adds score and creates floating score popup.
     */
    addScore(points, x, y) {
      this.score += points;
      if (x !== undefined && y !== undefined && global.GameEntities && global.GameEntities.createParticle) {
        this.particles.push(global.GameEntities.createParticle(x, y, `+${points}`, '#FFD700'));
      }
      this.updateHUD();
    }

    /**
     * Adds collectible coin count and score, plays sound, emits particles.
     */
    addCoin(x, y) {
      this.coins++;
      this.score += 200;
      this.triggerHaptic(20);
      if (x !== undefined && y !== undefined && global.GameEntities) {
        if (global.GameEntities.createFloatingMemeText) {
          this.particles.push(global.GameEntities.createFloatingMemeText(x, y, 'coin'));
        }
        if (global.GameEntities.createConfettiBurst) {
          this.particles.push(...global.GameEntities.createConfettiBurst(x, y, 6));
        }
      }
      if (global.GameAudio) {
        global.GameAudio.playCoin();
      }
      this.updateHUD();
    }

    /**
     * Synchronizes HUD display values in DOM.
     */
    updateHUD() {
      if (this.hudScore) {
        this.hudScore.textContent = String(this.score).padStart(6, '0');
      }
      if (this.hudCoins) {
        this.hudCoins.innerHTML = `&times;${String(this.coins).padStart(2, '0')}`;
      }
      if (this.hudWorld) {
        this.hudWorld.textContent = '2026';
      }
      if (this.hudTime) {
        this.hudTime.textContent = String(Math.max(0, Math.ceil(this.time))).padStart(3, '0');
      }
      if (this.hudLives) {
        this.hudLives.innerHTML = `&times;${this.lives}`;
      }
    }

    /**
     * Handles hitting a block from below.
     */
    handleBlockHit(tx, ty) {
      if (!this.level) return;
      const res = this.level.bumpBlock(tx, ty);
      if (!res) return;

      const worldX = tx * 16;
      const worldY = ty * 16;

      if (res.coinEarned) {
        // Pop coin out of block
        if (global.GameEntities && global.GameEntities.BlockCoin) {
          this.blockCoins.push(new global.GameEntities.BlockCoin(worldX, worldY));
        }
        this.addCoin(worldX + 8, worldY - 8);
      } else {
        this.triggerHaptic(30);
        if (global.GameEntities) {
          if (global.GameEntities.createFloatingMemeText) {
            this.particles.push(global.GameEntities.createFloatingMemeText(worldX + 8, worldY - 4, 'block'));
          }
          if (global.GameEntities.createConfettiBurst) {
            this.particles.push(...global.GameEntities.createConfettiBurst(worldX + 8, worldY, 4));
          }
        }
        if (global.GameAudio) {
          global.GameAudio.playBump();
        }
      }
    }

    /**
     * Triggers victory sequence when flagpole is reached.
     */
    handleFlagpole() {
      if (this.state === 'WIN') return;
      this.state = 'WIN';
      this.winTimer = 0;
      this.modalRevealed = false;
      this.triggerHaptic([100, 50, 100, 50, 200]);
      this.addScore(1000, this.player ? this.player.x : 0, this.player ? this.player.y - 16 : 0);

      if (this.goalFlag) {
        this.goalFlag.startSlide();
      }
      if (global.GameAudio) {
        global.GameAudio.playWin();
      }

      // Initial confetti celebration burst around flagpole
      if (this.player && global.GameEntities && global.GameEntities.createConfettiBurst) {
        this.particles.push(...global.GameEntities.createConfettiBurst(this.player.x + 8, this.player.y, 16, { speed: 120 }));
      }
    }

    /**
     * Handles player death.
     */
    handlePlayerDeath() {
      if (this.player && this.player.state !== 'DEAD') {
        this.player.die();
        this.lives--;
        this.updateHUD();
      }
    }

    /**
     * Core Physics & Game Logic Update.
     */
    update(dt) {
      // 1. Get User Input State
      const input = global.GameInput ? global.GameInput.getState() : { left: false, right: false, jump: false };

      // Handle Quick Restart Input (KeyR or Reset flag)
      if (input.reset) {
        this.startNewGame();
        this.state = 'PLAYING';
        if (global.GameInput) global.GameInput.update();
        return;
      }

      // ----------------------------------------------------
      // STATE: PLAYING
      // ----------------------------------------------------
      if (this.state === 'PLAYING') {
        // Countdown Time
        this.timeTimer += dt;
        if (this.timeTimer >= 1.0) {
          this.timeTimer -= 1.0;
          this.time--;
          this.updateHUD();
          if (this.time <= 0) {
            this.handlePlayerDeath();
          }
        }

        // Update Level animations & blocks
        if (this.level) {
          this.level.update(dt);
        }

        // Update Player
        if (this.player) {
          this.player.update(
            dt,
            input,
            this.level,
            (tx, ty) => this.handleBlockHit(tx, ty),
            () => this.handleFlagpole()
          );

          // Reset combo streak when player lands on solid ground
          if (this.player.isOnGround) {
            this.comboStreak = 0;
          }

          // If player died, check for transition to GAMEOVER
          if (this.player.state === 'DEAD' && this.player.deathTimer > 2.0) {
            this.state = 'GAMEOVER';
            this.gameOverTimer = 0;
          }
        }

        // Update Camera tracking player
        if (this.level && this.player && this.player.state !== 'DEAD') {
          this.level.updateCamera(this.player.x, VIEWPORT_WIDTH);
        }

        const cameraX = this.level ? this.level.cameraX : 0;

        // Update Meme Enemies
        for (let i = this.goombas.length - 1; i >= 0; i--) {
          const goomba = this.goombas[i];
          // Only update active enemies within 300px of camera view
          if (goomba.x >= cameraX - 64 && goomba.x <= cameraX + VIEWPORT_WIDTH + 64) {
            goomba.update(
              dt,
              this.level,
              this.player,
              (x, y, enemyType) => {
                this.comboStreak = (this.comboStreak || 0) + 1;
                const bonus = this.comboStreak > 1 ? this.comboStreak * 50 : 0;
                this.score += 100 + bonus;
                this.triggerHaptic(40);
                if (global.GameEntities) {
                  if (global.GameEntities.createFloatingMemeText) {
                    const text = this.comboStreak > 1 ? `COMBO ×${this.comboStreak}! 🔥` : null;
                    this.particles.push(global.GameEntities.createFloatingMemeText(x + 8, y, 'stomp', enemyType || goomba.type));
                    if (text) {
                      this.particles.push(global.GameEntities.createParticle(x + 8, y - 14, text, '#FF5722'));
                    }
                  }
                  if (global.GameEntities.createConfettiBurst) {
                    this.particles.push(...global.GameEntities.createConfettiBurst(x + 8, y, 6));
                  }
                }
                if (global.GameAudio) global.GameAudio.playStomp();
                this.updateHUD();
              },
              () => this.handlePlayerDeath()
            );
          }
          if (!goomba.isAlive) {
            this.goombas.splice(i, 1);
          }
        }

        // Update Collectible Coins
        for (let i = this.coinsList.length - 1; i >= 0; i--) {
          const coin = this.coinsList[i];
          coin.update(dt, this.player, (x, y) => this.addCoin(x + 8, y));
          if (!coin.isAlive) {
            this.coinsList.splice(i, 1);
          }
        }

        // Update Block Coins
        for (let i = this.blockCoins.length - 1; i >= 0; i--) {
          const bc = this.blockCoins[i];
          bc.update(dt);
          if (!bc.isAlive) {
            this.blockCoins.splice(i, 1);
          }
        }

        // Update Goal Flag
        if (this.goalFlag) {
          this.goalFlag.update(dt);
        }

        // Update Floating Text & Confetti Particles
        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.update(dt);
          if (!p.isAlive) {
            this.particles.splice(i, 1);
          }
        }
      }

      // ----------------------------------------------------
      // STATE: WIN (Victory Sequence)
      // ----------------------------------------------------
      else if (this.state === 'WIN') {
        this.winTimer += dt;

        if (this.level) {
          this.level.update(dt);
        }
        if (this.player) {
          this.player.update(dt, { left: false, right: false, jump: false }, this.level, null, null);
        }
        if (this.goalFlag) {
          this.goalFlag.update(dt);
        }

        // Celebratory confetti shower across the screen during victory
        if (Math.random() < 0.35 && global.GameEntities && global.GameEntities.createVictoryConfetti && this.level) {
          this.particles.push(...global.GameEntities.createVictoryConfetti(this.level.cameraX + VIEWPORT_WIDTH / 2, 10, 3));
        }

        for (let i = this.particles.length - 1; i >= 0; i--) {
          const p = this.particles[i];
          p.update(dt);
          if (!p.isAlive) this.particles.splice(i, 1);
        }

        // Trigger Victory Modal reveal after celebratory delay or when player reaches castle
        if (!this.modalRevealed && (this.winTimer >= 1.8 || (this.player && this.player.state === 'IDLE' && this.winTimer >= 0.5))) {
          this.modalRevealed = true;
          this.showVictoryModal();
        }

        // Allow restart after win sequence with jump key/touch
        if (this.winTimer > 2.5 && (input.jump || input.jumpJustPressed)) {
          this.startNewGame();
          this.state = 'PLAYING';
        }
      }

      // ----------------------------------------------------
      // STATE: GAMEOVER
      // ----------------------------------------------------
      else if (this.state === 'GAMEOVER') {
        this.gameOverTimer += dt;
        // Allow tap / jump to restart after 1s
        if (this.gameOverTimer > 1.0 && (input.jump || input.jumpJustPressed || input.left || input.right)) {
          if (this.lives <= 0) {
            this.lives = 3;
            this.score = 0;
            this.coins = 0;
          }
          this.startNewGame();
          this.state = 'PLAYING';
        }
      }

      // Clear edge pulses for next frame
      if (global.GameInput) {
        global.GameInput.update();
      }
    }

    /**
     * Renders the complete game scene to Canvas.
     */
    render() {
      if (!this.ctx || !this.canvas) return;

      const ctx = this.ctx;
      const cameraX = this.level ? this.level.cameraX : 0;
      const playerX = this.player ? this.player.x : 0;

      // 1. Clear Screen with Retro Sky Blue (#5C94FC)
      ctx.fillStyle = '#5C94FC';
      ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

      ctx.save();
      // Apply 2x Pixel Scale (180x400 virtual -> 360x800 native canvas)
      ctx.scale(WORLD_SCALE, WORLD_SCALE);

      // 2. Draw Decorative Distant Background Hills & Deal-With-It Clouds
      this.drawBackground(ctx, cameraX);

      // 3. Draw Level Tilemap, Sky Banner & Milestone Signs
      if (this.level) {
        this.level.draw(ctx, VIEWPORT_WIDTH, VIEWPORT_HEIGHT, playerX);
      }

      // 4. Draw Goal Flag
      if (this.goalFlag) {
        this.goalFlag.draw(ctx, cameraX);
      }

      // 5. Draw Collectibles (Coins)
      this.coinsList.forEach(c => c.draw(ctx, cameraX));

      // 6. Draw Block Pop-up Coins
      this.blockCoins.forEach(bc => bc.draw(ctx, cameraX));

      // 7. Draw Meme Enemies (PopCat, Doge, GrumpyCat)
      this.goombas.forEach(g => g.draw(ctx, cameraX));

      // 8. Draw Player (Super Iván)
      if (this.player) {
        this.player.draw(ctx, cameraX);
      }

      // 9. Draw Floating Meme Combat Text & Confetti Particles
      this.particles.forEach(p => p.draw(ctx, cameraX));

      // 10. Draw Fallback Canvas Overlays (Game Over)
      this.drawOverlays(ctx);

      ctx.restore();
    }

    /**
     * Draws procedural background clouds with Deal-With-It sunglasses and rolling hills.
     */
    drawBackground(ctx, cameraX) {
      // Parallax Clouds (slow scroll)
      const cloudCam = cameraX * 0.3;
      ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
      for (let i = 0; i < 15; i++) {
        const cx = Math.round((i * 140 + 30) - cloudCam);
        const cy = 40 + (i % 2 === 0 ? 0 : 8);

        if (cx > -60 && cx < VIEWPORT_WIDTH + 60) {
          // Cloud Body
          ctx.beginPath();
          ctx.arc(cx, cy, 10, 0, Math.PI * 2);
          ctx.arc(cx + 10, cy - 4, 14, 0, Math.PI * 2);
          ctx.arc(cx + 22, cy, 10, 0, Math.PI * 2);
          ctx.fill();

          // "Deal-With-It" Sunglasses on Cloud Center
          const sx = cx + 4;
          const sy = cy - 6;

          // Black Sunglasses Frames & Bridge
          ctx.fillStyle = '#000000';
          // Left Lens
          ctx.fillRect(sx, sy, 5, 4);
          // Right Lens
          ctx.fillRect(sx + 7, sy, 5, 4);
          // Bridge
          ctx.fillRect(sx + 4, sy + 1, 4, 1);
          // Temples
          ctx.fillRect(sx - 1, sy, 1, 2);
          ctx.fillRect(sx + 12, sy, 1, 2);

          // White Specular Glints (45° diagonal glint)
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(sx + 1, sy + 1, 1, 1);
          ctx.fillRect(sx + 2, sy + 2, 1, 1);
          ctx.fillRect(sx + 8, sy + 1, 1, 1);
          ctx.fillRect(sx + 9, sy + 2, 1, 1);
        }
      }

      // Ground Hills
      const hillCam = cameraX * 0.6;
      ctx.fillStyle = '#00A800';
      for (let i = 0; i < 12; i++) {
        const hx = Math.round((i * 180 + 20) - hillCam);
        if (hx > -80 && hx < VIEWPORT_WIDTH + 80) {
          ctx.beginPath();
          ctx.arc(hx, 208, 28, Math.PI, 0);
          ctx.fill();
        }
      }
    }

    /**
     * Draws Game Over overlay (when victory modal handles WIN state).
     */
    drawOverlays(ctx) {
      if (this.state === 'GAMEOVER') {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
        ctx.fillRect(15, 80, VIEWPORT_WIDTH - 30, 80);

        ctx.fillStyle = '#E52521';
        ctx.font = 'bold 12px "Press Start 2P", monospace, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('GAME OVER', VIEWPORT_WIDTH / 2, 108);

        ctx.fillStyle = '#FFFFFF';
        ctx.font = '8px "Press Start 2P", monospace, sans-serif';
        ctx.fillText('TAP TO RESTART', VIEWPORT_WIDTH / 2, 135);
      }
    }

    /**
     * Main Game Loop driven by requestAnimationFrame.
     */
    loop(timestamp) {
      if (!this.isRunning) return;

      const rawDt = (timestamp - this.lastTime) / 1000;
      this.lastTime = timestamp;

      // Delta time clamp to prevent physics explosion on background/tab switch
      const dt = Math.min(Math.max(rawDt, 0.001), 0.05);

      this.update(dt);
      this.render();

      if (typeof requestAnimationFrame !== 'undefined') {
        requestAnimationFrame(this.loop);
      }
    }
  }

  // Create Global Game Instance
  const Game = new GameManager();

  const targetScope = typeof window !== 'undefined'
    ? window
    : (typeof globalThis !== 'undefined' ? globalThis : global);

  targetScope.Game = Game;

  // Auto-init in browser DOM environment
  if (typeof window !== 'undefined') {
    const shouldStartNow = window.location.hash === '#mario' || window.location.search.includes('game=mario');
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        Game.init(shouldStartNow);
      });
    } else {
      Game.init(shouldStartNow);
    }
  }

  if (typeof module !== 'undefined' && module.exports) {
    module.exports = Game;
  }
})(typeof window !== 'undefined' ? window : (typeof globalThis !== 'undefined' ? globalThis : global));
